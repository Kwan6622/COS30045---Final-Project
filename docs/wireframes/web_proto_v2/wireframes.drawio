do": role picker + action panel' style="text;rounded=1;arcSize=23;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontFamily=Helvetica;fontSize=20;fontColor=#1F2328;fontStyle=1;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="20.0" y="14.0" width="900.0" height="26.0" as="geometry"/></mxCell><mxCell id="p9c1" value="The reader picks how they use the road; the panel repeats the relevant numbers and lists sourced actions." style="text;rounded=1;arcSize=33;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;dashed=0;fontFamily=Helvetica;fontSize=12;fontColor=#7A7A7A;fontStyle=0;align=left;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="20.0" y="40.0" width="1000.0" height="18.0" as="geometry"/></mxCell><mxCell id="p9c2" value="I drive&lt;br&gt;car, ute or van" style="rounded=1;arcSize=17;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2328;strokeWidth=2;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#1F2328;fontStyle=1;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="20.0" y="70.0" width="164.0" height="60.0" as="geometry"/></mxCell><mxCell id="p9c3" value="" style="endArrow=none;endFill=1;html=1;rounded=0;strokeColor=#F2B705;strokeWidth=4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="136.0" as="sourcePoint"/><mxPoint x="174.0" y="136.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p9c4" value="I walk&lt;br&gt;or my parents do" style="rounded=1;arcSize=17;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A8A8A8;strokeWidth=1;dashed=0;fontFamily=Helvetica;fontSize=11;fontColor=#1F2328;fontStyle=0;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="194.0" y="70.0" width="164.0" height="60.0" as="geometry"/></mxCell><mxCell id="p9c5" value="I ride&lt;br&gt;bike or e-bike